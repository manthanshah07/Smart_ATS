# Django Core Settings
SECRET_KEY=django-insecure-change-me-in-production-smartats-key-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL / Neon)
