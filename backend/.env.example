# ─── Django Core ───────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Set to False in production
DEBUG=True

# Production: your Render service hostname, e.g. smartats-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ──────────────────────────────────────────────────────────────────
# Local dev: postgres://USER@localhost:5432/smartats_db
# Neon production: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartats_db

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Production: set to your Vercel deployment URL, e.g. https://smartats.vercel.app
# Multiple origins comma-separated (no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ─── Email ─────────────────────────────────────────────────────────────────────
# Development: django.core.mail.backends.console.EmailBackend
# Production (optional): django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@smartats.local

# ─── SMTP (only needed if EMAIL_BACKEND is SMTP) ───────────────────────────────
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# ─── Django Settings Module ────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=smart_ats.settings
