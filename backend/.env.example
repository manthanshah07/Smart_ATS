DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartats_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Media & Static Files
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
