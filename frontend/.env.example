# SmartATS Frontend Environment Configuration

# The base URL of the Django backend REST API.
# Local development typically runs on port 8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo Mode controls whether the application uses mock authentication and static mock data.
# Set to 'true' to enable the prototype persona testing bar and mock logic.
# Set to 'false' to connect strictly to the real Django backend for production / phase 3 testing.
VITE_DEMO_MODE=true
